name: Build Android APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    env:
      SERVER_BASE_URL: "https://1212.gerdoo.app"

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Build Release APK
        uses: gradle/gradle-build-action@v3
        with:
          gradle-version: '8.9'
          arguments: assembleRelease
        env:
          KEYSTORE_PATH: ${{ github.workspace }}/alzahra-release.keystore
          KEYSTORE_PASSWORD: AlzahraUni2026!
          KEY_ALIAS: alzahra
          KEY_PASSWORD: AlzahraUni2026!

      - name: Upload Release APK
        uses: actions/upload-artifact@v4
        with:
          name: Alzahra-Release-APK
          path: app/build/outputs/apk/release/app-release.apk
